# Café+ — Variables de entorno
# Copiar como .env y completar los valores
# NUNCA commitear .env (está en .gitignore)

# Google Apps Script — URL del web app desplegado
# Obtener en: GAS editor → Implementar → Nueva implementación → Web app
VITE_API_URL=

# API key para autenticación con el backend GAS
VITE_GAS_API_KEY=

# n8n — webhook del agente IA (workflow Cafe_Plus)
VITE_N8N_WEBHOOK=

# Clerk — clave pública del proyecto
# Obtener en: dashboard.clerk.com → API Keys
VITE_CLERK_PUBLISHABLE_KEY=
